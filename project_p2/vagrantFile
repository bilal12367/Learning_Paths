Vagrant.configure("2") do |config|
    # Define the box (Ubuntu in this case)
    config.vm.box = "ubuntu/focal64"
  
    # Configure network settings for a static IP address
    # config.vm.network "private_network", type: "dhcp"  # For host-only or internal network
    config.vm.network "public_network", ip: "192.168.0.8"  # Set static IP (replace with your desired IP)
    config.vm.synced_folder ".", "/vagrant_data", type: "virtualbox", mount_options: ["dmode=777", "fmode=777"]

    # Configure VM resources
    config.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"  # Memory size
      vb.cpus = 2         # Number of CPUs
    end
  
    # Provision VM to install Docker
    config.vm.provision "shell", inline: <<-SHELL
      # Update package list
      sudo apt-get update -y
      
      # Install Docker
      sudo apt-get install -y docker.io
      
      # Start and enable Docker service
      sudo systemctl start docker
      sudo systemctl enable docker
      
      # Test Docker installation
      sudo docker --version

       # Install Node.js from NodeSource repository
        # Install required dependencies
        sudo apt-get install -y curl gnupg2 lsb-release ca-certificates

        # Add the NodeSource repository for Node.js 16 (you can change this to another version)
        curl -fsSL https://deb.nodesource.com/setup_18.x | sudo -E bash -

        # Install Node.js and npm
        sudo apt-get install -y nodejs

        # Verify Node.js and npm installation
        node -v
        npm -v
    SHELL
  
    # Set VM hostname (optional)
    config.vm.hostname = "docker-vm"
    
    # Configure SSH access (optional)
    # config.ssh.username = "vagrant"
    # config.ssh.private_key_path = "~/.vagrant.d/insecure_private_key"
    # config.ssh.forward_agent = false
  end
  