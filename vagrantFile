# Vagrantfile
Vagrant.configure("2") do |config|
    # Use an Ubuntu base box
    config.vm.box = "ubuntu/bionic64"
  
    # Ensure Docker is installed
    config.vm.provision "docker"
    config.vm.network "public_network", ip: "192.168.0.9" # Change this to your desired IP

    # Run the MySQL container using Docker
    config.vm.provision "shell", inline: <<-SHELL
      docker pull mysql:latest
      docker run --name mysql -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=test -p 3306:3306 -d mysql:latest
      docker start mysql
      # Create a startup script
      echo '#!/bin/bash' > /etc/init.d/my_startup_script
      echo docker start mysql >> /etc/init.d/my_startup_script
      echo 'sudo apt-get update' >> /etc/init.d/my_startup_script

      # Make the script executable
      chmod +x /etc/init.d/my_startup_script

      # Register the script to run at boot
      update-rc.d my_startup_script defaults
    SHELL
  
    # Expose port 3306 for MySQL
    config.vm.network "forwarded_port", guest: 3306, host: 3306
  
    # Optional: Configure VM resources
    config.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
  end
  